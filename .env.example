# Convex (application backend / database)
# Set automatically in .env.local by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Clerk (authentication / identity)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk JWT issuer domain, used by convex/auth.config.ts so Convex can
# validate Clerk session tokens. Comes from the "convex" JWT template in
# the Clerk dashboard (Configure > JWT Templates). Must also be set on the
# Convex deployment itself via `npx convex env set CLERK_JWT_ISSUER_DOMAIN ...`
# — this .env.local copy is not read by Convex functions directly.
CLERK_JWT_ISSUER_DOMAIN=

# Point Clerk at our own sign-in/sign-up pages instead of its hosted Account
# Portal. Read by clerkMiddleware's auth.protect() redirect, not just by
# <ClerkProvider>, so this must be an env var, not only a component prop.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stream Video (learning session video calls)
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=
